PORT=4000
CORS_ORIGIN=http://localhost:5173

# Servidor SMTP usado para enviar el mensaje del formulario de contacto.
# Si usas Gmail, genera un "App Password" (no tu contraseña normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password

# A dónde llega el mensaje del formulario
CONTACT_TO_EMAIL=tu-correo@gmail.com
